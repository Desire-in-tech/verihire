# Copy to .env for local development. Leave secrets empty in git.
# DATABASE_URL is a Postgres connection string (Supabase or another free
# Postgres). When it is unset, the API uses the SQLite file below.
DATABASE_URL=
VERIHIRE_DB_PATH=

# Comma-separated frontend origins. Do not use *.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional. When both are set, seed jobs attach to this one employer.
# The password is stored as a hash and is not overwritten on later boots.
EMPLOYER_BOOTSTRAP_EMAIL=
EMPLOYER_BOOTSTRAP_PASSWORD=
EMPLOYER_BOOTSTRAP_NAME=

AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TOKEN=
AI_SERVICE_TIMEOUT=60

# Leave empty unless a Midnight service you control is running.
# An empty value reports verification as not configured. It does not invent
# a proof or transaction id.
MIDNIGHT_SERVICE_URL=
MIDNIGHT_SERVICE_TIMEOUT=60

ENABLE_API_DOCS=
