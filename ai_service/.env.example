# Copy this file to .env. Without ANTHROPIC_API_KEY the service uses the
# offline keyword fallback and does not call Claude.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-5

# Shared with the backend as AI_SERVICE_TOKEN. Required before /extract
# accepts CV text. Leave it empty in git.
AI_SERVICE_TOKEN=

AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
