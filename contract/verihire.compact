// VeriHire eligibility-proof contract
//
// What this file does
// --------------------
// This is the actual Midnight smart contract: a Compact circuit that
// checks a candidate's private credentials against a job's public
// requirements, and writes ONLY the pass/fail result (keyed by an opaque
// hash, never a name or CV) to public ledger state. Nobody reading the
// chain learns the candidate's real years of experience, certifications,
// or education - only whether a given (candidate, job) pair cleared the
// bar. That's the "private inference gating" pattern from the hackathon's
// AI track: proving eligibility without revealing the underlying data.
//
// This source is compiled with the current tested preprod toolchain
// (Compact compiler 0.31.1 / Compact runtime 0.16.0).
//
// Design choice: a Compact circuit's shape (its inputs) is fixed at
// compile time - it can't take an arbitrary-length list of skills the way
// the Python rules engine does. So this contract hardcodes the same four
// criteria used in the flagship demo job (Python years, PostgreSQL
// presence, AWS certification, Bachelor's-or-equivalent) rather than the
// fully generic skill map the backend uses. Supporting arbitrary jobs for
// real would mean either compiling a small family of fixed-shape circuits
// or padding every job to some max-N criteria - worth a real discussion
// before this goes past the hackathon demo.

pragma language_version 0.23;

import CompactStandardLibrary;

// Public ledger state: candidate+job pair (as an opaque hash computed
// off-chain by the backend) -> whether they were found eligible. This is
// the only thing this contract ever makes public.
export ledger eligibilityResults: Map<Bytes<32>, Boolean>;

// A private witness: the caller (our backend, acting as the prover on the
// candidate's behalf) supplies these values, but they are never disclosed
// on-chain - only used inside the circuit to compute a Boolean result.
// (Circuit parameters in Compact are private by default; disclose() is
// what explicitly allows a value to be written to public ledger state.)
circuit meetsMinimumYears(actualYears: Uint<16>, requiredYears: Uint<16>): Boolean {
  return actualYears >= requiredYears;
}

export circuit proveEligibility(
  resultKey: Bytes<32>,        // hash of (candidate_ref, job_id) - identifies this proof publicly
  pythonYears: Uint<16>,        // PRIVATE: candidate's actual Python years
  hasPostgresql: Boolean,       // PRIVATE
  hasAwsCert: Boolean,          // PRIVATE
  hasBachelorsOrEquivalent: Boolean,  // PRIVATE
  requiredPythonYears: Uint<16>,      // public requirement, from the job posting
  requirePostgresql: Boolean,
  requireAwsCert: Boolean,
  requireBachelors: Boolean
): [] {
  const pythonOk = meetsMinimumYears(pythonYears, requiredPythonYears);
  const postgresOk = !requirePostgresql || hasPostgresql;
  const awsOk = !requireAwsCert || hasAwsCert;
  const educationOk = !requireBachelors || hasBachelorsOrEquivalent;

  const eligible = pythonOk && postgresOk && awsOk && educationOk;

  // Only the boolean result is disclosed - none of the private inputs above
  // ever leave this circuit.
  eligibilityResults.insert(disclose(resultKey), disclose(eligible));
}

// Read-only helper so a verifier (an employer's client, or anyone) can
// check a previously-recorded result without re-running the circuit.
export circuit checkResult(resultKey: Bytes<32>): Boolean {
  return eligibilityResults.lookup(disclose(resultKey));
}
