# Copy to .env for the local undeployed network. Do not put a real seed
# in this example. Public Preprod uses Blockfrost and a project token;
# these defaults are the local stack only.
# https://docs.midnight.network/guides/networks-and-environments

PORT=7000

# Proof server stays local on every network. It sees private inputs.
PROOF_SERVER_URL=http://localhost:6300

# Local undeployed node and indexer (midnight-local-dev).
NETWORK_ID=undeployed
NODE_URL=http://localhost:9944
INDEXER_URL=http://localhost:8088/api/v4/graphql
INDEXER_WS_URL=ws://localhost:8088/api/v4/graphql/ws

# Wallet seed/private key used to sign deployment + circuit-call transactions.
# NEVER commit a real value here - this is a hackathon demo wallet only.
WALLET_SEED=

# Encrypts the local Midnight private-state and signing-key stores.
# Use a strong value of at least 16 characters; never commit it.
MIDNIGHT_STORAGE_PASSWORD=

# Filled in by `npm run deploy-contract` once the contract is deployed -
# this is the on-chain address the server calls circuits on.
CONTRACT_ADDRESS=
