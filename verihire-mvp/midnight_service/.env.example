# Copy to .env once you have a real Midnight dev environment running.
# See README.md in this folder for what each of these points at and how
# to stand them up (proof server, node/indexer RPC, wallet seed).

PORT=7000

# Local proof server - see README.md for the docker run command.
PROOF_SERVER_URL=http://localhost:6300

# Midnight node + indexer RPC endpoints (testnet). Get current values from
# https://docs.midnight.network - these move as the network progresses.
NODE_RPC_URL=
INDEXER_URL=
INDEXER_WS_URL=

# Wallet seed/private key used to sign deployment + circuit-call transactions.
# NEVER commit a real value here - this is a hackathon demo wallet only.
WALLET_SEED=

# Filled in by `npm run deploy-contract` once the contract is deployed -
# this is the on-chain address the server calls circuits on.
CONTRACT_ADDRESS=
